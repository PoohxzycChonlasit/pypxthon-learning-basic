    "tolerance": 1e-08,
    "name": "benchmark สูงกว่า",
    "stdin": "[0.01,0.0]\n[0.02,0.01]\n",
    "expected_stdout": "strategy=0.0100 benchmark=0.0302 excess=-0.0202 beats=False\n"
  },
  {
    "args": [
      [
        0.1
      ],
      [
        0.1,
        0.2
      ]
    ],
    "expected": null,
    "tolerance": 1e-08,
    "name": "จำนวนช่วงไม่เท่ากัน",
    "stdin": "[0.1]\n[0.1,0.2]\n",
    "expected_stdout": "INVALID\n"
  },
  {
    "args": [
      [
        0.01,
        0.02
      ],
      [
        0.01,
        0.02
      ]
    ],
    "expected": {
      "strategy_net": 0.030200000000000005,
      "benchmark_net": 0.030200000000000005,
      "excess": 0.0,
      "beats": false
    },
    "tolerance": 1e-08,
    "name": "equal OOS results do not beat benchmark",
    "stdin": "[0.01,0.02]\n[0.01,0.02]\n",
    "expected_stdout": "strategy=0.0302 benchmark=0.0302 excess=0.0000 beats=False\n"
  },
  {
